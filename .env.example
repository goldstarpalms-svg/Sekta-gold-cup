# === SEKTA GOLD - ULTIMATE CHATBOT CONFIG ===
# 1. Copy this file to .env
# 2. Put your NEW key after you revoke the leaked one at https://platform.openai.com/api-keys
# 3. NEVER commit .env to git

# REQUIRED - OpenAI
OPENAI_API_KEY=sk-proj-YOUR_NEW_KEY_HERE
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_STT_MODEL=whisper-1

# OPTIONAL - For superpowers
TAVILY_API_KEY=  # Get free key at tavily.com for real web search
SERPAPI_KEY=     # Alternative web search
ELEVENLABS_API_KEY= # For ultra-realistic voice

# Server
BACKEND_PORT=8000
FRONTEND_PORT=5173
SECRET_KEY=sekta-gold-ultra-secret-change-me

# Features
ENABLE_MEMORY=true
ENABLE_WEB_SEARCH=true
ENABLE_IMAGE_GEN=true
ENABLE_VOICE=true
ENABLE_CODE_INTERPRETER=true
MAX_FILE_SIZE_MB=50

# --- Cyber Shield dashboard (app.py) ---
# Recommended: put these in .streamlit/secrets.toml instead of .env.
# Slack incoming webhook for honeypot + brute-force alerts
SLACK_WEBHOOK_URL=
# Optional ipapi.co key for higher IP-geolocation limits
IPAPI_KEY=

# --- AI features (optional; add at least one to enable AI Assistant + Advisor) ---
# Free tiers recommended. Blank keys are skipped gracefully.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=  # optional: higher-quality web search in the AI Assistant

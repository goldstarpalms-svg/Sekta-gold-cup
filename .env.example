# Environment variables for the Setka Cup prediction app.
#
# Usage:
#   1. Copy this file to ".env"  (the ".env" file is gitignored and must never be committed).
#   2. Fill in your real credentials.
#   3. The app reads these via os.getenv(); export them in your shell, or load the
#      .env file with a tool like `python-dotenv`, or set them in
#      .streamlit/secrets.toml (see .streamlit/secrets.toml.example).
#
# Required -----------------------------------------------------------------
# The Odds API key — used by the Live Odds page (src/odds_api.py).
# Get a free key at https://www.theoddsapi.com/
THE_ODDS_API_KEY=your_the_odds_api_key_here

# Optional integrations ----------------------------------------------------
# Pinnacle sportsbook (src/external_clients.py) — live betting data.
PINNACLE_USERNAME=your_pinnacle_username
PINNACLE_PASSWORD=your_pinnacle_password

# Betfair Exchange (src/external_clients.py) — market data.
BETFAIR_APP_KEY=your_betfair_app_key
BETFAIR_SESSION_TOKEN=your_betfair_session_token

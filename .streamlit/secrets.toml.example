# Copy this to secrets.toml locally OR paste into Streamlit Cloud → Secrets
# NEVER commit real secrets.toml
#
# --- Cyber Shield dashboard (app.py) ---
# Central Slack notifier. Create one at https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL = "https://hooks.slack.com/services/PUT_YOURS_HERE"
# Optional: ipapi.co API key for higher geolocation limits (free tier works without it)
IPAPI_KEY = ""

# --- AI features (optional; at least one enables the AI Assistant + Advisor) ---
# Free tiers recommended. Add whichever you have; the app degrades gracefully if blank.
GROQ_API_KEY = ""    # free: console.groq.com/keys
GEMINI_API_KEY = ""  # free: aistudio.google.com/apikey
OPENAI_API_KEY = ""  # paid: platform.openai.com/api-keys
